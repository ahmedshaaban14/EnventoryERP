<Window x:Class="InventoryERP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory ERP"
        Height="860"
        Width="1480"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#F3F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppPrimaryBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#DCE3EC" />
        <SolidColorBrush x:Key="AppMutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AppSidebarBrush" Color="#0F172A" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="HeaderChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="☰" Width="44" Height="40" Margin="0,0,12,0" Click="ToggleSidebarButton_Click" Background="#EEF2FF" Foreground="#0F172A" />
                    <StackPanel>
                        <TextBlock Text="{Binding CompanyName}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="نظام ERP لإدارة المخزون والمبيعات والمشتريات" Foreground="{StaticResource AppMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Height="40"
                         Margin="24,0"
                         Padding="14,8"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#F8FAFC"
                         BorderBrush="{StaticResource AppBorderBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HeaderChipStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUser}" FontWeight="SemiBold" />
                            <TextBlock Text="المستخدم الحالي" FontSize="11" Foreground="{StaticResource AppMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HeaderChipStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentDateTime, StringFormat={}{0:yyyy-MM-dd}}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentDateTime, StringFormat={}{0:HH:mm:ss}}" FontSize="11" Foreground="{StaticResource AppMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Content="الإعدادات" Background="#0F172A" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource AppSidebarBrush}" Padding="16" CornerRadius="0,20,20,0">
                <StackPanel>
                    <TextBlock Text="القائمة الرئيسية" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="لوحة التحكم" Click="DashboardButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="الأصناف" Click="ItemsButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="الفواتير" Click="InvoicesButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="العملاء" Click="CustomersButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="الموردين" Click="SuppliersButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="الخزنة" Click="CashButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="التقارير" Click="ReportsButton_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="16" Background="{StaticResource AppSurfaceBrush}" CornerRadius="20" Padding="20" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <Grid>
                    <ScrollViewer x:Name="DashboardContent" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="لوحة التحكم" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
                            <WrapPanel>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="إجمالي الأصناف" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.TotalItems}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="قيمة المخزون" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.CurrentInventoryValue}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="مبيعات الشهر" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.MonthlySales}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="مشتريات الشهر" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.MonthlyPurchases}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <WrapPanel>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="الأصناف المنخفضة" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.LowStockItems}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="مستحقات العملاء" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.TotalCustomerReceivables}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="مستحقات الموردين" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.TotalSupplierPayables}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" Width="240" Margin="0,0,12,12" Padding="16" CornerRadius="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="رصيد الخزنة" Foreground="{StaticResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Summary.CashBalance}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ContentControl x:Name="MainContent" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
