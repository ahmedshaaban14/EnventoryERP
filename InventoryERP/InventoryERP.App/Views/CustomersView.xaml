<UserControl x:Class="InventoryERP.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1D4ED8" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="إدارة العملاء" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="بحث سريع وحسابات العملاء والرصيد الحالي" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,6" />
                    <Button Grid.Column="1" Content="مسح" Command="{Binding RefreshCommand}" Background="#E2E8F0" Foreground="#0F172A" Margin="8,0,0,0" />
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="110" />
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="140" />
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding CurrentBalance}" Width="100" />
                        <DataGridTextColumn Header="الحد الائتماني" Binding="{Binding CreditLimit}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="بيانات العميل" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="إضافة أو تعديل ملف العميل" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="الاسم" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding EditorCustomer.Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="الهاتف" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding EditorCustomer.Phone, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="العنوان" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding EditorCustomer.Address, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="السيارة" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding EditorCustomer.Car, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="الحد الائتماني" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding EditorCustomer.CreditLimit, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="ملاحظات" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding EditorCustomer.Notes, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="جديد" Command="{Binding NewCustomerCommand}" Background="#E2E8F0" Foreground="#0F172A" />
                        <Button Content="حفظ" Command="{Binding SaveCustomerCommand}" />
                        <Button Content="حذف" Command="{Binding DeleteCustomerCommand}" Background="#DC2626" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
