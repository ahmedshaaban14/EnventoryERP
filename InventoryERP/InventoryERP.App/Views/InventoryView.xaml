<UserControl x:Class="InventoryERP.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="المخزون" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="أصناف منخفضة" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding LowStockItems}" DisplayMemberPath="Name" BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding StockMovements}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding MovementDate}" Width="160" />
                        <DataGridTextColumn Header="الصنف" Binding="{Binding Item.Name}" Width="*" />
                        <DataGridTextColumn Header="النوع" Binding="{Binding MovementType}" Width="100" />
                        <DataGridTextColumn Header="قبل" Binding="{Binding QuantityBefore}" Width="70" />
                        <DataGridTextColumn Header="التغير" Binding="{Binding QuantityChange}" Width="70" />
                        <DataGridTextColumn Header="بعد" Binding="{Binding QuantityAfter}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
