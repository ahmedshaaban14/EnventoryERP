<UserControl x:Class="InventoryERP.App.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="الخزنة" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12" />
                <WrapPanel>
                    <Border Background="#F8FAFC" Padding="16" CornerRadius="12" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الرصيد الحالي" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding CurrentBalance}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" Padding="16" CornerRadius="12" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المقبوضات" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding TotalReceipts}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" Padding="16" CornerRadius="12" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المدفوعات" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding TotalPayments}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="الخزن" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding CashSafes}"
                             SelectedItem="{Binding SelectedCashSafe, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="حركة الخزنة" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding CashMovements}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding MovementDate}" Width="160" />
                            <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*" />
                            <DataGridTextColumn Header="النوع" Binding="{Binding OperationType}" Width="100" />
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
