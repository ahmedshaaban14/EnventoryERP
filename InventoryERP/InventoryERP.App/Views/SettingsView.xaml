<UserControl x:Class="InventoryERP.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="الإعدادات" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="إعدادات عامة، النسخ الاحتياطي، والمظهر" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" />

                <TextBlock Text="اسم الشركة" Foreground="{StaticResource MutedBrush}" />
                <TextBox Text="{Binding CompanyName}" Margin="0,0,0,12" Height="36" Padding="10,6" />

                <TextBlock Text="اسم التطبيق" Foreground="{StaticResource MutedBrush}" />
                <TextBox Text="{Binding ApplicationName}" Margin="0,0,0,12" Height="36" Padding="10,6" />

                <CheckBox Content="الوضع الداكن" IsChecked="{Binding DarkModeEnabled}" Margin="0,0,0,12" />

                <TextBlock Text="مجلد النسخ الاحتياطي" Foreground="{StaticResource MutedBrush}" />
                <TextBox Text="{Binding BackupFolder}" Margin="0,0,0,12" Height="36" Padding="10,6" />

                <WrapPanel>
                    <Button Content="نسخ احتياطي" Width="140" Margin="0,0,8,8" />
                    <Button Content="استعادة" Width="140" Margin="0,0,8,8" />
                    <Button Content="إدارة المستخدمين" Width="160" Margin="0,0,8,8" />
                    <Button Content="سجل العمليات" Width="140" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
