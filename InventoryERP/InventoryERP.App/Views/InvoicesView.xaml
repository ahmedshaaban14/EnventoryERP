<UserControl x:Class="InventoryERP.App.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="الفواتير" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <WrapPanel>
                <Button Content="فاتورة شراء" Width="140" Margin="0,0,10,8" Click="AddPurchaseInvoiceButton_Click"/>
                <Button Content="فاتورة بيع" Width="140" Margin="0,0,10,8" Click="AddSaleInvoiceButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,10">
            <TextBlock Text="رقم الفاتورة" Margin="0,0,0,4"/>
            <TextBox x:Name="InvoiceNumberTextBox" Width="220" HorizontalAlignment="Left"/>
            <TextBlock Text="كود الصنف أو الاسم (اختياري)" Margin="0,10,0,4"/>
            <TextBox x:Name="ItemCodeTextBox" Width="220" HorizontalAlignment="Left"/>
            <TextBlock Text="الكمية" Margin="0,10,0,4"/>
            <TextBox x:Name="QuantityTextBox" Width="220" HorizontalAlignment="Left" Text="1"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Text="الفواتير الآن تُحفظ في قاعدة البيانات وتُولّد أرقاماً تلقائياً عند عدم إدخال رقم." Margin="0,10,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
    </Grid>
</UserControl>